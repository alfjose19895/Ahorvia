# ==============================================================================
# AHORVIA — FINANZAS PERSONALES
# Plantilla de Configuración Oficial para Producción en BanaHosting (cPanel)
# ==============================================================================

APP_NAME="Ahorvia"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://tu-dominio.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES
APP_CURRENCY=USD

# Registro público cerrado por seguridad (crear usuarios vía: php artisan ahorvia:create-user)
AHORVIA_REGISTRATION_ENABLED=false

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Logs diarios en storage/logs/laravel-YYYY-MM-DD.log
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# ------------------------------------------------------------------------------
# Base de Datos MySQL (Crear en cPanel > MySQL Databases)
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tuusuario_ahorvia
DB_USERNAME=tuusuario_ahorvia_usr
DB_PASSWORD="TU_PASSWORD_MYSQL_SEGURO"
DB_ENGINE=InnoDB
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# ------------------------------------------------------------------------------
# Sesiones Seguras y Cifradas en Base de Datos (100% compatible con cPanel)
# ------------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# ------------------------------------------------------------------------------
# Caché y Colas en Base de Datos (No requiere Redis ni Supervisor)
# ------------------------------------------------------------------------------
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# ------------------------------------------------------------------------------
# Correo Electrónico (Configurable con el correo corporativo de cPanel)
# ------------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mail.tu-dominio.com
MAIL_PORT=465
MAIL_USERNAME=notificaciones@tu-dominio.com
MAIL_PASSWORD="TU_PASSWORD_CORREO_CPANEL"
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="notificaciones@tu-dominio.com"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------------------------
# Identidad de Marca y PWA
# ------------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"

