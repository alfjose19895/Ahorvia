# ==============================================================================
# Ahorvia — Protección de Archivos Sensibles (cPanel / Apache / LiteSpeed)
# ==============================================================================

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Bloqueo estricto de acceso a archivos ocultos, configuración y código fuente
    RewriteRule ^(\.env|\.git|composer\.(json|lock)|package\.(json|lock)|phpunit\.xml|phpstan\.neon|artisan|DEPLOYMENT\.md|PROJECT_STATUS\.md|AGENTS\.md) - [F,L,NC]
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests)/ - [F,L,NC]
</IfModule>

# Deshabilitar listado de directorios
Options -Indexes
